# === AegisRAG .gitignore ===

# --- Private session files (never push) ---
PROJECT_LOG.md
CONTEXT.md

# --- Secrets & credentials ---
.env
credentials.json
token.json

# --- Python virtual environment ---
.venv/
venv/
env/

# --- Python cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Distribution / packaging ---
dist/
build/
*.egg-info/

# --- IDE / editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- OS generated ---
.DS_Store
Thumbs.db

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/

# --- Logs ---
*.log

# --- Phase 2 generated artifacts (large, reproducible from ingest.py) ---
chroma_db/
chunks/

# --- Phase 3 generated artifacts (large, reproducible from evaluate.py) ---
results/
RESULTS_WRITEUP.md
