# AegisRAG Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Notion Personal Access Token
# Create one at: https://www.notion.so/profile/integrations
NOTION_API_KEY=your_notion_pat_here

# Path to your Google OAuth credentials JSON file
# Download from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CREDENTIALS_PATH=credentials.json

# Google Drive folder ID to scope the Drive connector
# Get it from the URL: drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_FOLDER_ID=your_drive_folder_id_here
